# ── ElevenLabs Agents Platform ──────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_ESTIMATOR=
ELEVENLABS_AGENT_ID_CALLER=
ELEVENLABS_AGENT_ID_CLOSER=

# ── Telephony (real outbound calls) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# or SIP trunk credentials if going that route
SIP_TRUNK_URI=

# ── Market discovery (build the call list) ──────────────────────────────────
GOOGLE_PLACES_API_KEY=
YELP_FUSION_API_KEY=

# ── Document parsing (vision / OCR for the Estimator) ───────────────────────
# Uses an LLM/vision provider of your choice for photos, quotes, bills.
VISION_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# Which vertical config to load from config/verticals/<VERTICAL>.json
VERTICAL=wedding-dress
# Where quotes/transcripts are written (sqlite path, postgres url, etc.)
DATABASE_URL=
