# ── LLM (agents: Estimator, Buyer Agent, Seller Agent) ──────────────────────
ANTHROPIC_API_KEY=

# ── Caller: fan-out web search (pick one or more) ───────────────────────────
EXA_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
# business call lists (optional)
GOOGLE_PLACES_API_KEY=
YELP_FUSION_API_KEY=

# ── Voice leg — the one live call (pick one provider) ───────────────────────
VAPI_API_KEY=
RETELL_API_KEY=
BLAND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Estimator: voice intake (ElevenLabs Agents Platform) ────────────────────
# Without a key, negotiator/voice_intake.py still builds a valid agent config and
# returns it with a `mock` marker instead of calling the network.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ── Shared state (optional; in-memory blackboard by default) ────────────────
REDIS_URL=

# ── App ──────────────────────────────────────────────────────────────────────
# One of: wedding-dress | moving | ecommerce-packaging (config/verticals/*.json)
VERTICAL=wedding-dress
